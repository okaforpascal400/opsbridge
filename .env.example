# Copy this file to .env and fill in the values. Never commit .env.

# Postgres connection used by the app and the seed script.
# Matches the docker-compose service defaults.
DATABASE_URL=postgresql+psycopg2://opsbridge:opsbridge@localhost:5432/opsbridge

# Anthropic credentials. Unused in Phase 1, wired up in Phase 3.
ANTHROPIC_API_KEY=
# The model is pinned here, never hardcoded at a call site.
ANTHROPIC_MODEL=claude-opus-5

# Tests only. The seed test drops and recreates the legacy schema, so point
# this at a throwaway database, never at your development one.
OPSBRIDGE_TEST_DATABASE_URL=postgresql+psycopg2://opsbridge:opsbridge@localhost:5432/opsbridge_test
